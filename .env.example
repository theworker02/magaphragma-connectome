# Affinity / Vast environment (never commit secrets)

# Vast.ai — required for cloud fleet commands
VAST_API_KEY=

# Hard financial constraints
AFFINITY_CLOUD_BUDGET_USD=160
AFFINITY_TARGET_BUDGET_USD=100
AFFINITY_BENCHMARK_BUDGET_USD=5

# Offer filters
AFFINITY_MIN_VRAM_GB=6
AFFINITY_MIN_RELIABILITY=0.98
AFFINITY_MIN_DISK_GB=32
AFFINITY_MIN_CPU_RAM_GB=8

# Claim coordination (local default; http for Vast+local multi-host)
S7_CLAIM_BACKEND=local
# S7_CLAIM_HTTP=http://127.0.0.1:8787

# Worker
S7_TILE_BATCH=16
S7_INFER_BACKEND=eager
# S7_WORKER_ID=local-rocm-0

# AWS is DECOMMISSIONED for Affinity production — do not set:
# S7_CLAIM_BACKEND=dynamodb
# S7_DDB_TABLE=
# S7_ARTIFACT_BUCKET=
# AWS_PROFILE=   (only for optional audit_aws_affinity_resources.py cleanup)
